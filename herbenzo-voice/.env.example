# Herbenzo voice agent configuration.
# Copy to the repo-root .env (already git-ignored) and fill in secrets. Never commit real values.

ENV=dev

# --- Provider credentials ---
NVIDIA_API_KEY=nvapi-...
# NGC_API_KEY=            # only for self-hosted NIM containers
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# --- LLM roles (provider: nvidia | anthropic | google | fake) ---
LLM_EXTRACTOR_PROVIDER=nvidia
LLM_EXTRACTOR_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_RESPONDER_PROVIDER=nvidia
LLM_RESPONDER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_RED_FLAG_PROVIDER=nvidia
LLM_RED_FLAG_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_DISABLE_THINKING=true

# --- Guardrails ---
GUARDRAILS_ENABLED=true
GUARDRAILS_CONFIG_PATH=herbenzo_agent/guardrails/herbenzo-intake-nemoguard
GUARDRAILS_BASE_URL=https://integrate.api.nvidia.com/v1
GUARDRAILS_TIMEOUT_S=3
GUARDRAILS_TOPIC_CONTROL=false
GUARDRAILS_OUTPUT_ENABLED=true

# --- Storage ---
DATABASE_URL=sqlite:///data/herbenzo_voice.db

# --- Service security (generate with: python3 -c "import secrets;print(secrets.token_urlsafe(32))") ---
INTERNAL_API_TOKEN=
ADMIN_API_TOKEN=
# Prod profile (ENV=prod): required on POST /v1/chat as header X-Chat-Token.
# Localhost demo profile (ENV=dev, default): leave unset; /v1/chat stays open behind rate limits.
CHAT_BOOTSTRAP_TOKEN=
# Override auto rule (auto = required only when ENV=prod). Examples:
#   CHAT_AUTH_REQUIRED=true   # force token even in ENV=dev
#   CHAT_AUTH_REQUIRED=false  # never require (not for prod)
# CHAT_AUTH_REQUIRED=
CORS_ALLOW_ORIGINS=["https://localhost"]

# --- Handoff to Stage A Recommender ---
RECOMMENDER_URL=http://localhost:8000
RECOMMENDER_TIMEOUT_S=600
HANDOFF_ENABLED=true
HANDOFF_MIN_CONFIDENCE=0.5
# PIPELINE_MODE=true (default): /ready returns 503 when Stage A is down;
# unavailable NemoGuard / content-safety input rails fail closed (turn rejected).
# Set false for intake-only demo: /ready ignores A; guardrails fail open on unavailable.
PIPELINE_MODE=true

# --- Intake policy ---
MIN_ADULT_AGE=18
MAX_USER_TURNS=30
AYURVEDIC_CONTEXT_ENABLED=true
RESPONDER_TIMEOUT_S=6
DEFAULT_LANGUAGE=en-IN
DEFAULT_JURISDICTION=IN
TRANSCRIPT_RETENTION_DAYS=90

# --- Logging ---
LOG_LEVEL=INFO
LOG_CONTENT=false

# --- Voice controller ---
VOICE_CONFIG_PATH=configs/riva_public.yaml   # or configs/riva_self_hosted.yaml
AGENT_URL=http://localhost:8081
VOICE_ALLOWED_ORIGINS=http://localhost:4400
ENABLE_SPECULATIVE_SPEECH=false             # keep false: the agent keeps conversation memory
DUMP_AUDIO_FILES=false
TURN_SERVER_URL=
TURN_USERNAME=
TURN_PASSWORD=

# --- Web front door (docker compose) ---
SITE_ADDRESS=localhost        # public domain in production
CADDY_TLS=tls internal        # set to an empty comment ("#") for automatic public certificates
